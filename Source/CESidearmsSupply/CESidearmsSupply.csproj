<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net48</TargetFramework>
        <LangVersion>latest</LangVersion>
        <Nullable>disable</Nullable>
        <AssemblyName>CESidearmsSupply</AssemblyName>
        <RootNamespace>CESidearmsSupply</RootNamespace>
        <OutputPath>..\..\Assemblies\</OutputPath>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
        <DebugType>none</DebugType>
        <GenerateDependencyFile>false</GenerateDependencyFile>
        <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
        <RimWorldWorkshopDir Condition="'$(RimWorldWorkshopDir)' == ''">$(HOME)/.local/share/Steam/steamapps/workshop/content/294100</RimWorldWorkshopDir>
    </PropertyGroup>

    <ItemGroup>
        <!-- The staging assembly drives PlayerIntent's scope directly: the alternative is
             constructing SS's gizmo and writing its private selection field, which would test
             more of SS than of this mod. -->
        <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
            <_Parameter1>CESupplyTestStaging</_Parameter1>
        </AssemblyAttribute>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
        <PackageReference Include="Krafs.Rimworld.Ref" Version="1.6.*" />
        <PackageReference Include="Lib.Harmony" Version="2.3.3" ExcludeAssets="runtime" />
    </ItemGroup>

    <ItemGroup>
        <Reference Include="CombatExtended">
            <HintPath>$(RimWorldWorkshopDir)/2890901044/Assemblies/CombatExtended.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="SimpleSidearms">
            <HintPath>$(RimWorldWorkshopDir)/927155256/v1.6/Assemblies/SimpleSidearms.dll</HintPath>
            <Private>false</Private>
        </Reference>
    </ItemGroup>

</Project>
