<?xml version="1.0" encoding="utf-8" ?>
<!--
  Attaches the per-pawn record to the Pawn base def, the same way Simple
  Sidearms attaches its own memory comp. PatchOperationConditional tests once,
  document-wide: BasePawn always has a <comps> list, so the match branch runs
  and nomatch is a dead safety net; child pawn defs inherit the comp.
-->
<Patch>

    <Operation Class="PatchOperationConditional">
        <xpath>/Defs/ThingDef[thingClass="Pawn"]/comps</xpath>
        <nomatch Class="PatchOperationAdd">
            <xpath>/Defs/ThingDef[thingClass="Pawn"]</xpath>
            <value>
                <comps>
                    <li Class="CESimpleSidearmsCompat.Loadouts.CompProperties_LoadoutSidearms"></li>
                </comps>
            </value>
        </nomatch>
        <match Class="PatchOperationAdd">
            <xpath>/Defs/ThingDef[thingClass="Pawn"]/comps</xpath>
            <value>
                <li Class="CESimpleSidearmsCompat.Loadouts.CompProperties_LoadoutSidearms"></li>
            </value>
        </match>
    </Operation>

</Patch>
